{
  "name": "rudra-ai",
  "version": "1.0.0",
  "description": "RUDRA AI - Autonomous Desktop Intelligence",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "dev:electron": "electron .",
    "desktop:dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:prod": "set \"NODE_ENV=production\"&& electron .",
    "start": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start:desktop": "npm run build:frontend && npm run electron:prod",
    "build:frontend": "npm run build --prefix frontend"
  },
  "keywords": [
    "ai",
    "assistant",
    "desktop",
    "electron",
    "fastapi",
    "react",
    "ollama"
  ],
  "author": "RUDRA AI Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "wait-on": "^7.2.0",
    "ws": "^8.21.3"
  }
}
